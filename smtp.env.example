# Copy these settings into the backend .env and use your provider's values.
EMAIL_ENABLED=true
EMAIL_FROM="Ticket System <tickets@yourdomain.com>"
EMAIL_TIMEZONE=Asia/Kolkata
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Port 587 requires STARTTLS. For implicit TLS, use port 465 and SMTP_SECURE=true.
